# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# MongoDB Atlas Configuration (Persists shows and subscribers across server restarts)
DATABASE_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ott_notifier_db

# Interval between checking for new episodes (in seconds). Default: 600 (10 minutes)
CHECK_INTERVAL_SECONDS=600

# Web server port for Koyeb / Cloud health checks
PORT=8080
